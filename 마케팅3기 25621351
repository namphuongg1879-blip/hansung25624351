  try {
    actx = actx || new (window.AudioContext || window.webkitAudioContext)();
    const notes = kind === 'win' ? [523, 659, 784, 1046] : kind === 'bad' ? [300, 220] : [660];
    notes.forEach((f, i) => { const o = actx.createOscillator(), gn = actx.createGain(), t = actx.currentTime + i * .09;
      o.type = 'triangle'; o.frequency.value = f; gn.gain.setValueAtTime(.001, t); gn.gain.exponentialRampToValueAtTime(.18, t + .01); gn.gain.exponentialRampToValueAtTime(.001, t + .16);
      o.connect(gn).connect(actx.destination); o.start(t); o.stop(t + .18); });
  } catch (e) {}
}

