  const b = e.target.closest('.btn, .opt, .side, .topic'); if (!b) return;
  const r = b.getBoundingClientRect(), d = Math.max(r.width, r.height), sp = document.createElement('span');
  sp.className = 'ripple'; sp.style.cssText = `width:${d}px;height:${d}px;left:${e.clientX - r.left - d / 2}px;top:${e.clientY - r.top - d / 2}px`;
  b.appendChild(sp); setTimeout(() => sp.remove(), 600);
  if (e.target.closest('.opt, .side, .cand, .tcard, .topic')) sfx('tap');
});

/* ---------- 도구 ---------- */
function shuffle(arr, seed) {
  let s = seed || Math.floor(Math.random() * 1e9);
  const rnd = () => (s = (s * 1664525 + 1013904223) >>> 0) / 4294967296;
  for (let i = arr.length - 1; i > 0; i--) { const j = Math.floor(rnd() * (i + 1)); [arr[i], arr[j]] = [arr[j], arr[i]]; }
  return arr;
}
function toast(msg) { const t = $('#toast'); t.textContent = msg; t.classList.add('show'); clearTimeout(t._h); t._h = setTimeout(() => t.classList.remove('show'), 1900); }
function confetti() {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const box = document.createElement('div'); box.className = 'confetti';
  const colors = ['#FF7A45', '#FFE45C', '#5ED3B4', '#7C6BF2', '#FF9BB3'];
  for (let i = 0; i < 70; i++) { const p = document.createElement('i'); p.style.left = Math.random() * 100 + '%'; p.style.background = colors[i % 5]; p.style.animationDelay = Math.random() * .6 + 's'; box.appendChild(p); }
  document.body.appendChild(box); setTimeout(() => box.remove(), 2800);
}
async function share(text) {
  const url = location.href; text = text || SITE.shareText;
  try { if (navigator.share) { await navigator.share({ title: document.title, text, url }); return; } } catch (e) { return; }
  try { await navigator.clipboard.writeText(text + '\n' + url); toast('링크를 복사했어요. 친구에게 붙여넣어 보세요!'); }
  catch (e) { toast('주소창의 링크를 복사해서 공유해 주세요'); }
}
document.addEventListener('click', e => {
  const s = e.target.closest('.share-btn'); if (s) return share(s.dataset.text);
  const x = e.target.closest('.share-x'); if (x) return window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(x.dataset.text || SITE.shareText) + '&url=' + encodeURIComponent(location.href), '_blank', 'noopener');
  const sv = e.target.closest('.save-img'); if (sv) return saveImage(sv.dataset);
  const tr = e.target.closest('.try-btn'); if (tr) store.set('friend', { id: tr.dataset.id, key: tr.dataset.key });
  const l = e.target.closest('.like-btn'); if (l) { toggleLike(l.dataset.id); const on = isLiked(l.dataset.id); $$('.like-btn').forEach(b => { b.classList.toggle('liked', on); b.innerHTML = ic('heart') + ' 좋아요'; }); }
});
document.addEventListener('keydown', e => { if (e.target.matches('input,select,textarea') || e.metaKey || e.ctrlKey || e.altKey) return; if (keyHandler) keyHandler(e); });

/* ---------- 주소(링크)에 따라 화면 전환 ----------
   #/  홈   · #/c/test  카테고리   · #/play/아이디  시작 화면
   #/result/아이디/결과키  테스트 결과(공유용)   · #/me  MY 기록         */
function route() {
  clearInterval(bannerTimer); clearInterval(fxTimer); keyHandler = null;
  const [, a, b, c] = (location.hash || '#/').split('/');
  window.scrollTo(0, 0);
  if (a === 'c' && b) return renderHome(b);
  if (a === 'play' && byId(b)) return renderIntro(byId(b));
  if (a === 'result' && byId(b)) return renderTestResult(byId(b), decodeURIComponent(c || ''));
  if (a === 'me') return renderMe();
  renderHome('all');
}
window.addEventListener('hashchange', route);
route();
</script>
