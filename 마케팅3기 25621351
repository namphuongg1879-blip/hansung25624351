    ${mine ? `<a class="btn btn-main" href="#/play/${c.id}">${ic('rotate-ccw')} 다시 하기</a>` : `<a class="btn btn-main" href="#/play/${c.id}">${ic('sparkles')} 나도 테스트 하기</a>`}
    ${saveBtn(c.title, R.title, R.emoji, R.color, R.tags)}
    ${shareRow(c, `나는 "${R.title}"! 너는 어떤 유형이야?`)}
    <div class="more-title">다른 결과 구경하기</div>
    <div class="others">${keys.map(k => `<a class="${k === key ? 'me' : ''}" href="#/result/${c.id}/${k}">${art(c.results[k].emoji, 'art-xs')} ${esc(c.results[k].title)}</a>`).join('')}</div>
    <div class="more-title">이런 것도 해보세요</div><div class="grid">${others.map(x => cardHTML(x)).join('')}</div></div>`);
