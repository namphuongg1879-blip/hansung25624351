    <p class="kbd">${ic('keyboard')} 숫자 키 1~${topics.length}</p>`);
  $$('.topic').forEach(b => b.onclick = () => draw(topics[+b.dataset.k]));
  keyHandler = e => { const k = +e.key - 1; if (topics[k]) draw(topics[k]); };

  function draw(t) {
    const today = new Date().toISOString().slice(0, 10);
    const seed = [...(today + c.id + t.key)].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) >>> 0, 7);
    const deck = shuffle([...c.cards], seed).slice(0, 3);
