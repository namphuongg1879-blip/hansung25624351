<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>둥둥 · 심심할 땐 둥둥</title>
<meta name="description" content="심리테스트, 퀴즈, 밸런스 게임, 월드컵, 오늘의 타로를 한곳에서">
<meta name="theme-color" content="#FF7A45">

<!-- ▼ VWO SmartCode가 필요하면 여기에 붙여넣으세요 ▼ -->

<!-- ▲ VWO SmartCode 끝 ▲ -->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jua&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">

<style>
/* =========================================================
   색상 · 글꼴 — 여기 값만 바꾸면 전체 분위기가 바뀝니다
   ========================================================= */
:root{
  --bg:#F3F5FA; --paper:#FFFFFF; --ink:#1D1A3A; --soft:#6B6A85; --line:#E3E6F0;
  --main:#FF7A45; --main-dark:#E8622D; --main-soft:#FFEDE5;
  --lemon:#FFE45C; --mint:#5ED3B4; --violet:#7C6BF2; --violet-soft:#EFEAFF;
  --ok:#2FB57C; --bad:#F2545B;
  --display:'Jua','Pretendard',sans-serif;
  --body:'Pretendard',system-ui,-apple-system,sans-serif;
  --tab-h:0px;
}
html[data-theme="dark"]{
  --bg:#15142A; --paper:#221F3F; --ink:#F2F1FA; --soft:#A9A7C4; --line:#343158;
  --main-soft:#3A2A2A; --violet-soft:#2E2A57;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.55;padding-bottom:calc(var(--tab-h) + env(safe-area-inset-bottom));transition:background .25s,color .25s}
button{font-family:inherit;cursor:pointer;color:inherit}
a{color:inherit;text-decoration:none}
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--violet);outline-offset:2px}
img{display:block;max-width:100%}
.wrap{max-width:1200px;margin:0 auto;padding:0 18px}

/* ---------- 상단 헤더 ---------- */
.topbar{position:sticky;top:0;z-index:30;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top)}
.topbar .wrap{display:flex;align-items:center;gap:12px;height:62px}
.brand{display:flex;align-items:center;gap:8px;font-family:var(--display);font-size:26px}
.brand img{height:32px;width:auto}
.brand .dot{width:28px;height:28px;border-radius:50%;background:var(--main);display:grid;place-items:center;color:#fff;font-size:14px;box-shadow:inset -4px -4px 0 rgba(0,0,0,.14)}
.icon-btn{border:1px solid var(--line);background:var(--paper);width:40px;height:40px;border-radius:12px;font-size:18px;display:grid;place-items:center;flex:none}
.dnav{display:none;gap:4px;margin-left:18px}
.dnav a{padding:8px 12px;border-radius:10px;font-weight:600;color:var(--soft)}
.dnav a:hover{background:var(--paper);color:var(--ink)}
.dnav a.on{color:var(--ink);background:var(--paper);box-shadow:inset 0 -3px 0 var(--main)}
.top-right{margin-left:auto;display:flex;gap:8px;align-items:center}
.my-link{display:none;font-weight:700;padding:9px 14px;border-radius:12px;background:var(--ink);color:var(--bg)}

/* ---------- 하단 탭 (휴대폰 · 태블릿) ---------- */
.tabbar{position:fixed;bottom:0;left:0;right:0;background:var(--paper);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(5,1fr);padding:6px 4px calc(6px + env(safe-area-inset-bottom));z-index:40}
.tabbar a{display:flex;flex-direction:column;align-items:center;gap:1px;font-size:11px;color:var(--soft);padding:4px 0}
.tabbar a b{font-size:21px;line-height:1.2;font-weight:400}
.tabbar a.on{color:var(--ink);font-weight:700}

/* ---------- 홈 ---------- */
.home-hero{padding:22px 0 6px}
.home-hero h1{font-family:var(--display);font-weight:400;font-size:clamp(26px,4.4vw,40px);line-height:1.2;margin:0 0 14px}
.search{position:relative;max-width:560px}
.search input{width:100%;border:1.5px solid var(--line);background:var(--paper);color:var(--ink);border-radius:16px;padding:14px 16px 14px 44px;font-size:16px;font-family:inherit}
.search span{position:absolute;left:16px;top:50%;transform:translateY(-50%);opacity:.55}
.chips{display:flex;gap:8px;overflow-x:auto;padding:14px 0 16px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{flex:none;border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:8px 15px;font-size:14px;font-weight:600;white-space:nowrap}
.chip.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}

.banner{border-radius:24px;overflow:hidden;position:relative}
.slides{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
.slides::-webkit-scrollbar{display:none}
.slide{flex:0 0 100%;scroll-snap-align:start;height:200px;position:relative;display:flex;align-items:flex-end;padding:22px;color:#fff;background-size:cover;background-position:center;border-radius:0}
.slide::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(29,26,58,0) 15%,rgba(29,26,58,.75))}
.slide .txt{position:relative}
.slide .tag{display:inline-block;font-size:12px;font-weight:700;background:rgba(255,255,255,.22);padding:3px 9px;border-radius:8px;margin-bottom:8px}
.slide h2{font-family:var(--display);font-weight:400;font-size:26px;line-height:1.2;margin:0 0 4px}
.slide p{margin:0;font-size:14px;opacity:.9}
.dots{position:absolute;right:14px;top:14px;display:flex;gap:5px}
.dots i{width:7px;height:7px;border-radius:4px;background:rgba(255,255,255,.5);transition:.25s}
.dots i.on{width:18px;background:#fff}

.sec{padding-top:30px}
.sec-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
.sec h3{font-family:var(--display);font-weight:400;font-size:22px;margin:0}
.sec select{border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:10px;padding:7px 10px;font-family:inherit;font-size:13px}
.hlist{display:flex;gap:12px;overflow-x:auto;margin:0 -18px;padding:0 18px 6px;scroll-snap-type:x mandatory;scrollbar-width:none}
.hlist::-webkit-scrollbar{display:none}
.hlist .card{flex:0 0 150px;scroll-snap-align:start}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}

.card{display:block;background:var(--paper);border-radius:18px;overflow:hidden;border:1px solid var(--line);transition:transform .15s}
.card:hover{transform:translateY(-3px)}
.thumb{aspect-ratio:1/1;position:relative;overflow:hidden;display:grid;place-items:center}
.thumb img{width:100%;height:100%;object-fit:cover}
.emo{font-size:56px;line-height:1;filter:drop-shadow(0 4px 0 rgba(0,0,0,.08))}
.badge{position:absolute;left:8px;top:8px;background:rgba(29,26,58,.85);color:#fff;font-size:11px;font-weight:700;padding:3px 8px;border-radius:8px}
.badge.new{background:var(--violet)}
.badge.hot{background:var(--main)}
.card .meta{padding:10px 12px 12px}
.card .t{font-weight:700;font-size:14.5px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.7em}
.card .p{display:flex;justify-content:space-between;font-size:12px;color:var(--soft);margin-top:5px}
.rank{position:absolute;right:8px;bottom:4px;font-family:var(--display);font-size:36px;color:#fff;text-shadow:0 2px 0 rgba(0,0,0,.25)}
.empty{padding:40px 0;text-align:center;color:var(--soft);grid-column:1/-1}

/* ---------- 플레이 화면 공통 ---------- */
.playwrap{display:block;padding:18px 0 30px}
.play{max-width:640px;margin:0 auto}
.side-rec{display:none}
.hero-thumb{border-radius:24px;overflow:hidden;aspect-ratio:4/3;display:grid;place-items:center;position:relative}
.hero-thumb img{width:100%;height:100%;object-fit:cover}
.hero-thumb .emo{font-size:clamp(84px,14vw,120px)}
.kind{display:inline-block;margin-top:18px;font-size:12px;font-weight:700;color:var(--main);background:var(--main-soft);padding:4px 10px;border-radius:8px}
.play h1{font-family:var(--display);font-weight:400;font-size:clamp(28px,4.4vw,38px);line-height:1.25;margin:8px 0 6px}
.lead{color:var(--soft);margin:0 0 16px}
.stat{display:flex;flex-wrap:wrap;gap:14px;font-size:13px;color:var(--soft);margin-bottom:20px}
.btn{display:flex;align-items:center;justify-content:center;gap:6px;width:100%;border:0;border-radius:16px;padding:16px;font-size:17px;font-weight:800;background:none}
.btn-main{background:var(--main);color:#fff;box-shadow:0 5px 0 var(--main-dark)}
.btn-main:active{transform:translateY(3px);box-shadow:0 2px 0 var(--main-dark)}
.btn-line{background:var(--paper);border:1.5px solid var(--line)}
.btn-line.liked{border-color:var(--bad);color:var(--bad)}
.btn-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.btn-row.three{grid-template-columns:repeat(3,1fr)}
.notice{background:var(--violet-soft);border-radius:14px;padding:12px 14px;font-size:14px;margin-bottom:14px;display:flex;justify-content:space-between;gap:10px;align-items:center}
.notice a{font-weight:800;color:var(--violet);white-space:nowrap}
.kbd{font-size:12px;color:var(--soft);text-align:center;margin-top:14px;display:none}

.prog{display:flex;align-items:center;gap:10px;margin:0 0 22px}
.prog .bar{flex:1;height:10px;background:var(--line);border-radius:6px;overflow:hidden}
.prog .bar i{display:block;height:100%;background:var(--main);border-radius:6px;transition:width .35s}
.prog span{font-size:13px;font-weight:700;color:var(--soft);min-width:44px;text-align:right}
.prog button{border:0;background:none;color:var(--soft);font-size:13px;padding:4px 2px}

.qimg{border-radius:18px;overflow:hidden;margin-bottom:16px}
.qimg img{width:100%;height:220px;object-fit:cover}
.qno{text-align:center;font-family:var(--display);color:var(--main);font-size:18px}
.qtitle{font-family:var(--display);font-weight:400;font-size:clamp(23px,3.6vw,30px);line-height:1.35;margin:2px 0 22px;text-align:center;white-space:pre-line}
.opts{display:flex;flex-direction:column;gap:10px}
.opt{display:flex;gap:12px;align-items:center;border:1.5px solid var(--line);background:var(--paper);border-radius:16px;padding:15px 16px;font-size:16px;text-align:left;font-weight:600}
.opt .n{flex:none;width:26px;height:26px;border-radius:8px;background:var(--bg);display:grid;place-items:center;font-size:13px;color:var(--soft)}
.opt:hover{border-color:var(--main)}
.opt.picked{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.opt.right{background:#E3F7EE;border-color:var(--ok);color:#135C3D}
.opt.wrong{background:#FDE7E8;border-color:var(--bad);color:#8A1F24}
.explain{margin-top:14px;border-radius:14px;padding:14px 16px;background:var(--paper);border:1px dashed var(--line);font-size:14.5px}
.explain b{display:block;margin-bottom:2px}

/* 결과 */
.result{text-align:center}
.result .label{font-size:14px;color:var(--soft);margin:18px 0 2px}
.result h1{margin-top:0}
.desc{text-align:left;background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:16px 18px;margin:14px 0 14px;white-space:pre-line}
.tags{display:flex;flex-wrap:wrap;justify-content:center;gap:6px;margin-top:8px}
.tags span{font-size:13px;background:var(--violet-soft);color:var(--violet);padding:4px 10px;border-radius:999px;font-weight:700}
.ratio{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:14px 16px;text-align:left;margin-bottom:14px}
.ratio .row{display:flex;align-items:center;gap:10px;font-size:13px;margin:6px 0}
.ratio .row span:first-child{flex:0 0 42%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ratio .row .b{flex:1;height:10px;background:var(--line);border-radius:6px;overflow:hidden}
.ratio .row .b i{display:block;height:100%;background:var(--violet);border-radius:6px}
.ratio .row.me{font-weight:800}
.ratio .row.me .b i{background:var(--main)}
.match{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.match a{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:14px;text-align:center}
.match small{display:block;font-size:12px;color:var(--soft);font-weight:700}
.match .emo{font-size:40px;margin:6px 0}
.match b{font-size:14px;line-height:1.3;display:block}
.others{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:10px}
.others a{font-size:13px;border:1px solid var(--line);background:var(--paper);border-radius:999px;padding:6px 12px}
.others a.me{background:var(--ink);color:var(--bg)}
.more-title{font-family:var(--display);font-size:21px;text-align:left;margin:30px 0 12px}
.score{font-family:var(--display);font-size:64px;line-height:1;color:var(--main);margin-top:14px}
.score small{font-size:26px;color:var(--soft)}
.review{text-align:left;display:flex;flex-direction:column;gap:8px;margin-bottom:16px}
.review div{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:12px 14px;font-size:14px}
.review b{color:var(--ok)}

/* 밸런스 게임 */
.vs{display:flex;flex-direction:column;gap:10px;position:relative}
.side{position:relative;border:0;border-radius:22px;min-height:150px;padding:22px;font-size:20px;font-weight:800;color:#fff;overflow:hidden;text-align:center;display:grid;place-items:center;line-height:1.35}
.side.a{background:#FF7A45}
.side.b{background:#7C6BF2}
.side .bg{position:absolute;inset:0;background-size:cover;background-position:center;opacity:.35}
.side .lbl{position:relative}
.side .fill{position:absolute;left:0;top:0;bottom:0;background:rgba(255,255,255,.22);width:0;transition:width .6s cubic-bezier(.2,.8,.2,1)}
.side .pct{position:relative;display:block;font-family:var(--display);font-weight:400;font-size:30px;margin-top:4px;min-height:1em}
.side.dim{filter:saturate(.35) brightness(.92)}
.side.mine{outline:4px solid var(--lemon);outline-offset:-4px}
.vs-mark{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:54px;height:54px;border-radius:50%;background:var(--ink);color:var(--lemon);font-family:var(--display);font-size:22px;display:grid;place-items:center;z-index:2;border:4px solid var(--bg);pointer-events:none}
.comment{margin-top:14px;text-align:center;font-weight:700;min-height:1.5em}
.summary{display:flex;flex-direction:column;gap:8px;margin:16px 0 18px;text-align:left}
.summary div{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:12px 14px;font-size:14px}
.summary b{color:var(--main)}

/* 월드컵 */
.round{text-align:center;font-family:var(--display);font-size:26px;margin:4px 0 2px}
.round small{display:block;font-family:var(--body);font-size:13px;color:var(--soft)}
.pair{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px;position:relative}
.cand{border:1.5px solid var(--line);padding:0;background:var(--paper);border-radius:20px;overflow:hidden;transition:transform .2s,opacity .2s}
.cand .thumb{aspect-ratio:3/4}
.cand .thumb .emo{font-size:clamp(64px,12vw,96px)}
.cand .nm{padding:12px 8px;font-weight:800;font-size:16px}
.cand:hover{border-color:var(--main)}
.cand.win{transform:scale(1.03);border-color:var(--main)}
.cand.lose{opacity:.25}
.pair .vs-mark{top:42%}
.round-pick{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.crown{font-size:44px;text-align:center}
.path{display:flex;flex-direction:column;gap:6px;text-align:left;margin:14px 0}
.path div{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:10px 14px;font-size:14px;display:flex;justify-content:space-between}
.path span{color:var(--soft)}

/* 타로 */
.topics{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.topic{border:1.5px solid var(--line);background:var(--paper);border-radius:18px;padding:18px 12px;font-weight:800;font-size:16px}
.topic b{display:block;font-size:30px;font-weight:400;margin-bottom:4px}
.topic:hover{border-color:var(--violet)}
.deck{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:10px 0 18px;perspective:900px}
.tcard{display:block;width:100%;height:0;border:0;padding:0 0 160% 0;background:none;position:relative;transform-style:preserve-3d;transition:transform .7s}
.tcard:hover:not(.flip){transform:translateY(-6px)}
.tcard.flip{transform:rotateY(180deg)}
.tcard .face{position:absolute;inset:0;border-radius:14px;backface-visibility:hidden;overflow:hidden;display:flex;align-items:center;justify-content:center}
.tcard .tback{background:#1D1A3A;border:3px solid var(--lemon);background-image:radial-gradient(circle at 50% 50%,rgba(255,228,92,.25) 0 18%,transparent 19%),repeating-linear-gradient(45deg,rgba(255,255,255,.06) 0 6px,transparent 6px 12px);color:var(--lemon);font-size:26px}
.tcard .front{transform:rotateY(180deg);background:#FFF6D9;color:#1D1A3A;border:3px solid var(--lemon);flex-direction:column;gap:8px;padding:8px;text-align:center;font-weight:800;font-size:13px}
.tcard .front img{width:100%;height:76%;object-fit:cover;border-radius:8px}
.tcard .front .emo{font-size:44px}
.tcard.fade{opacity:.35}

/* MY */
.hist{display:flex;flex-direction:column;gap:8px}
.hist a{display:flex;gap:12px;align-items:center;background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:10px}
.hist .mini{width:52px;height:52px;border-radius:12px;display:grid;place-items:center;font-size:26px;flex:none}
.hist b{display:block;font-size:14.5px}
.hist small{color:var(--soft);font-size:12.5px}

/* 토스트 · 축하 · 애니메이션 */
.toast{position:fixed;left:50%;bottom:calc(var(--tab-h) + 24px);transform:translate(-50%,16px);background:var(--ink);color:var(--bg);padding:12px 20px;border-radius:999px;font-size:14px;opacity:0;transition:.25s;z-index:60;pointer-events:none;white-space:nowrap}
.toast.show{opacity:1;transform:translate(-50%,0)}
.confetti{position:fixed;inset:0;pointer-events:none;z-index:70;overflow:hidden}
.confetti i{position:absolute;top:-12px;width:9px;height:14px;border-radius:2px;animation:fall 1.8s ease-in forwards}
@keyframes fall{to{transform:translateY(105vh) rotate(540deg)}}
.pop{animation:pop .35s ease-out}
@keyframes pop{from{transform:translateY(8px);opacity:0}to{transform:none;opacity:1}}
footer{padding:36px 0 26px;font-size:12.5px;color:var(--soft);text-align:center}

/* =========================================================
   반응형: 휴대폰(기본) → 태블릿(640px~) → 컴퓨터(1024px~)
   ========================================================= */
@media (max-width:1023px){ :root{--tab-h:64px} }

/* 태블릿 · 아이패드 */
@media (min-width:640px){
  .wrap{padding:0 28px}
  .hlist{margin:0 -28px;padding:0 28px 6px}
  .hlist .card{flex-basis:190px}
  .grid{grid-template-columns:repeat(3,1fr);gap:16px}
  .slide{height:260px;padding:30px}
  .slide h2{font-size:34px}
  .vs{flex-direction:row}
  .side{flex:1;min-height:260px;font-size:22px}
  .topics{grid-template-columns:repeat(4,1fr)}
  .match{gap:14px}
}

/* 컴퓨터 */
@media (min-width:1024px){
  .tabbar{display:none}
  .dnav,.my-link{display:flex}
  .wrap{padding:0 32px}
  .grid{grid-template-columns:repeat(4,1fr);gap:18px}
  .hlist{display:grid;grid-template-columns:repeat(6,1fr);margin:0;padding:0;overflow:visible;gap:16px}
  .home-hero{padding:36px 0 6px;display:flex;align-items:flex-end;justify-content:space-between;gap:30px}
  .home-hero h1{margin:0}
  .search{flex:0 0 440px}
  /* 배너: 큰 배너 1 + 작은 배너 2 매거진 배치 */
  .banner{border-radius:0;overflow:visible}
  .slides{display:grid;grid-template-columns:2fr 1fr;grid-template-rows:170px 170px;gap:16px;overflow:visible}
  .slide{height:auto;border-radius:24px;overflow:hidden}
  .slide:first-child{grid-row:1/3}
  .slide:first-child h2{font-size:42px}
  .slide:not(:first-child) h2{font-size:24px}
  .slide:nth-child(n+4){display:none}
  .dots{display:none}
  .playwrap{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:40px;align-items:start;padding-top:28px}
