      <div id="tarotOut"></div><p class="kbd">${ic('keyboard')} 숫자 키 1~3</p>`);
    const flip = k => {
      if ($('.deck').dataset.done) return; $('.deck').dataset.done = 1;
      const cd = deck[k]; const btn = $$('.tcard')[k];
      btn.classList.add('flip'); $$('.tcard').forEach(x => { if (x !== btn) x.classList.add('fade'); });
      addHistory(c, `${t.name} · ${cd.name}`, cd.emoji, '');
      setTimeout(() => {
        $('#tarotOut').innerHTML = `<div class="result pop"><p class="label">${today} · ${esc(t.name)}</p><h1>${esc(cd.name)}</h1>
          <div class="desc">${esc((cd.lines && cd.lines[t.key]) || cd.message || '')}\n\n${esc(cd.luck || '')}</div>
          <button class="btn btn-main" id="otherTopic">${ic('sparkles')} 다른 운세도 보기</button>
          ${saveBtn(c.title + ' · ' + t.name, cd.name, cd.emoji, '#E4DEFF', [(cd.lines && cd.lines[t.key]) || '', cd.luck || ''])}
          ${shareRow(c, `오늘 나의 ${t.name} 카드는 '${cd.name}'! 너도 뽑아봐`)}</div>`;
        $('#otherTopic').onclick = () => playTarot(c); sfx('win');
        $('#tarotOut').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 750);
      keyHandler = null;
    };
    $$('.tcard').forEach(b => b.onclick = () => flip(+b.dataset.k));
