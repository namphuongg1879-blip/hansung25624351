/* ---------- 심리테스트 ---------- */
function playTest(c) {
  const picks = []; let i = 0;
  const step = () => {
    const Q = c.questions[i], n = c.questions.length;
    layout(c, `<div class="prog">${i ? `<button id="prev">← 이전</button>` : ''}<div class="bar"><i style="width:${(i / n) * 100}%"></i></div><span>${i + 1} / ${n}</span></div>
      ${Q.image ? `<div class="qimg"><img src="${esc(Q.image)}" alt="" onerror="this.parentNode.remove()"></div>` : ''}
      <div class="q-head">${mascot(i % 3 === 2 ? 'wow' : 'think')}<div class="qno">Q${i + 1}</div></div><h2 class="qtitle">${esc(Q.q)}</h2>
      <div class="opts">${Q.options.map((o, k) => `<button class="opt" data-k="${k}" style="--d:${k}"><span class="n">${k + 1}</span>${esc(o.text)}</button>`).join('')}</div>
      <p class="kbd">${ic('keyboard')} 숫자 키 1~${Q.options.length}로 고를 수 있어요</p>`);
    requestAnimationFrame(() => { const b = $('.prog .bar i'); if (b) b.style.width = ((i + 1) / n) * 100 + '%'; });
    const pick = k => {
      const b = $$('.opt')[k]; if (!b || b.dataset.done) return; $$('.opt').forEach(x => x.dataset.done = 1);
      b.classList.add('picked'); picks[i] = k;
      setTimeout(() => { i++; i < n ? step() : finish(); }, 230);
    };
    $$('.opt').forEach(b => b.onclick = () => pick(+b.dataset.k));
    if ($('#prev')) $('#prev').onclick = () => { i--; step(); };
    keyHandler = e => { const k = +e.key - 1; if (k >= 0 && k < Q.options.length) pick(k); };
  };
  const finish = () => {
    const score = {};
    picks.forEach((k, qi) => Object.entries(c.questions[qi].options[k].score || {}).forEach(([key, v]) => score[key] = (score[key] || 0) + v));
    let key;
    if (c.axes) key = c.axes.map(ax => (score[ax[1]] || 0) > (score[ax[0]] || 0) ? ax[1] : ax[0]).join('');
    else { const keys = Object.keys(c.results); key = keys.reduce((a, k) => (score[k] || 0) > (score[a] || 0) ? k : a, keys[0]); }
    const R = c.results[key];
    addHistory(c, R.title, R.emoji, `#/result/${c.id}/${key}`);
    sessionStorage.setItem('justPlayed', c.id);
    analyzing(c, () => { location.hash = `#/result/${c.id}/${key}`; });
  };
  step();
}
