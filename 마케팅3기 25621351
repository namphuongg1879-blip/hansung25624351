/* ---------- 퀴즈 ---------- */
function playQuiz(c) {
  let i = 0, right = 0; const wrongs = [];
  const step = () => {
    const Q = c.questions[i], n = c.questions.length;
    layout(c, `<div class="prog"><div class="bar"><i style="width:${((i + 1) / n) * 100}%"></i></div><span>${i + 1} / ${n}</span></div>
      <div class="qno">문제 ${i + 1} · 현재 ${right}점</div><h2 class="qtitle">${esc(Q.q)}</h2>
      <div class="opts">${Q.options.map((o, k) => `<button class="opt" data-k="${k}" style="--d:${k}"><span class="n">${k + 1}</span>${esc(o)}</button>`).join('')}</div>
      <div id="exp"></div><p class="kbd">${ic('keyboard')} 숫자 키로 답하고, Enter로 다음 문제</p>`);
    const answer = k => {
      if ($('.opts').dataset.done) return; $('.opts').dataset.done = 1;
      const ok = k === Q.answer; if (ok) right++; else wrongs.push(Q); sfx(ok ? 'win' : 'bad');
      $$('.opt').forEach((b, x) => { if (x === Q.answer) b.classList.add('right'); else if (x === k) b.classList.add('wrong'); });
      $('#exp').innerHTML = `<div class="explain pop"><b class="${ok ? 'ok-t' : 'bad-t'}">${ok ? ic('check') + ' 정답!' : ic('x') + ' 아쉬워요'}</b>${esc(Q.explain || '')}</div>
        <div style="height:14px"></div><button class="btn btn-main" id="next">${i + 1 < n ? '다음 문제' : '결과 보기'}</button>`;
      $('#next').onclick = next; keyHandler = e => { if (e.key === 'Enter') next(); };
    };
    const next = () => { i++; i < n ? step() : done(); };
    $$('.opt').forEach(b => b.onclick = () => answer(+b.dataset.k));
    keyHandler = e => { const k = +e.key - 1; if (k >= 0 && k < Q.options.length) answer(k); };
  };
  const done = () => analyzing(c, showScore, '채점하는 중…');
  const showScore = () => {
    const n = c.questions.length;
    const g = [...c.grades].reverse().find(x => right >= x.min) || c.grades[0];
    addHistory(c, `${right}/${n}점 · ${g.title}`, c.emoji, '');
    layout(c, `<div class="result">
      <div class="score"><span data-count="${right}" data-plain="1">0</span><small> / ${n}</small></div>
      <p class="label">${esc(c.title)}</p><h1>${esc(g.title)}</h1><div class="desc">${esc(g.desc)}</div>
      ${wrongs.length ? `<div class="more-title" style="margin-top:6px">${ic('list-ordered')} 틀린 문제 다시 보기</div><div class="review">${wrongs.map(q =>
        `<div>${esc(q.q.replace(/\n/g, ' '))}<br>정답: <b>${esc(q.options[q.answer])}</b><br><small style="color:var(--soft)">${esc(q.explain || '')}</small></div>`).join('')}</div>` : ''}
      <a class="btn btn-main" href="#/play/${c.id}">${ic('rotate-ccw')} 다시 도전</a>
      ${saveBtn(c.title, g.title, c.emoji, c.color, [`${right} / ${n}점`])}
      ${shareRow(c, `${c.title} ${right}/${n}점! 너는 몇 점?`)}</div>`);
    sfx(right >= n / 2 ? 'win' : 'tap'); if (right >= Math.ceil(n * .8)) confetti();
    keyHandler = null;
  };
  step();
}

/* ---------- 밸런스 게임 ---------- */
function playBalance(c) {
  let i = 0; const picks = [];
  const votes = store.get('bal_' + c.id, {});
  const step = () => {
    const it = c.items[i], n = c.items.length;
    const side = (s, txt, img) => `<button class="side ${s}" data-s="${s}">${img ? `<span class="bg" style="background-image:url('${esc(img)}')"></span>` : ''}<span class="fill"></span><span class="lbl">${esc(txt)}<span class="pct"></span></span></button>`;
    layout(c, `<div class="prog"><div class="bar"><i style="width:${((i + 1) / n) * 100}%"></i></div><span>${i + 1} / ${n}</span></div>
      <h2 class="qtitle">둘 중 하나만 고른다면?</h2>
      <div class="vs" id="vs">${side('a', it.a, it.aImage)}<span class="vs-mark">VS</span>${side('b', it.b, it.bImage)}</div>
      <div class="comment" id="cm"></div>
      <div id="nextWrap" style="margin-top:14px;visibility:hidden"><button class="btn btn-main" id="next">${i + 1 < n ? '다음 문제' : '결과 보기'}</button></div>
      <p class="kbd">${ic('keyboard')} 1 또는 2로 고르고, Enter로 다음</p>`);
    const choose = s => {
      if ($('#vs').dataset.done) return; $('#vs').dataset.done = 1;
      const k = String(i); votes[k] = votes[k] || { a: 0, b: 0 }; votes[k][s]++; store.set('bal_' + c.id, votes);
      const A = (it.aVotes || 0) + votes[k].a, B = (it.bVotes || 0) + votes[k].b, T = A + B || 1;
      const pa = Math.round(A / T * 100), pb = 100 - pa, mineP = s === 'a' ? pa : pb;
      picks.push({ it, s, p: mineP });
      $$('.side').forEach(x => { const p = x.dataset.s === 'a' ? pa : pb; x.querySelector('.pct').textContent = p + '%'; x.querySelector('.fill').style.width = p + '%'; x.classList.add(x.dataset.s === s ? 'mine' : 'dim'); });
      $('#cm').textContent = mineP >= 65 ? '대부분이 당신과 같은 선택!' : mineP <= 35 ? '소수만 고른 선택이에요' : '거의 반반! 치열하네요';
      $('#nextWrap').style.visibility = 'visible';
      keyHandler = e => { if (e.key === 'Enter') next(); };
    };
    const next = () => { i++; i < c.items.length ? step() : done(); };
    $$('.side').forEach(b => b.onclick = () => choose(b.dataset.s));
    $('#next').onclick = next;
    keyHandler = e => { if (e.key === '1') choose('a'); if (e.key === '2') choose('b'); };
  };
  const done = () => {
    const minor = picks.filter(p => p.p < 50).length, ratio = minor / picks.length;
    const v = ratio >= .6 ? ['확고한 소수파', '남들과 다른 길을 가는 당신. 취향이 뚜렷하고 소신이 있어요.']
