/* ---------- 이상형 월드컵 ---------- */
function playCup(c) {
  const sizes = [32, 16, 8, 4].filter(s => s <= c.candidates.length);
  if (sizes.length > 1) {
    layout(c, `<div class="round">몇 강으로 할까요?<small>후보 ${c.candidates.length}개 중 무작위로 뽑아요</small></div>
      <div class="round-pick">${sizes.map(s => `<button class="btn btn-line" data-s="${s}">${s}강</button>`).join('')}</div>`);
    $$('.round-pick button').forEach(b => b.onclick = () => run(+b.dataset.s));
    keyHandler = null;
  } else run(sizes[0]);

  function run(size) {
    let round = shuffle([...c.candidates]).slice(0, size), next = [], idx = 0; const path = [];
    const label = n => n === 2 ? '결승' : n + '강';
    const step = () => {
      const a = round[idx], b = round[idx + 1];
      const cand = (x, k) => `<button class="cand" data-k="${k}">${visual(x.image, x.emoji, x.color, 'thumb')}<div class="nm">${esc(x.name)}</div></button>`;
      layout(c, `<div class="prog"><div class="bar"><i style="width:${((size - round.length + idx / 2 + 1) / (size - 1)) * 100}%"></i></div><span>${label(round.length)}</span></div>
        <div class="round">${label(round.length)}<small>${idx / 2 + 1} / ${round.length / 2}</small></div>
        <div class="pair">${cand(a, 0)}<span class="vs-mark">VS</span>${cand(b, 1)}</div>
        <p class="kbd">${ic('keyboard')} ← → 방향키로 고를 수 있어요</p>`);
      const pick = k => {
        if ($('.pair').dataset.done) return; $('.pair').dataset.done = 1;
        const win = k ? b : a;
        $$('.cand').forEach((x, j) => x.classList.add(j === k ? 'win' : 'lose'));
        path.push({ r: label(round.length), w: win.name, l: (k ? a : b).name });
        setTimeout(() => {
          next.push(win); idx += 2;
          if (idx >= round.length) { if (next.length === 1) return champion(next[0], path); round = next; next = []; idx = 0; }
          step();
        }, 380);
      };
      $$('.cand').forEach(btn => btn.onclick = () => pick(+btn.dataset.k));
      keyHandler = e => { if (e.key === 'ArrowLeft') pick(0); if (e.key === 'ArrowRight') pick(1); };
    };
    step();
  }
  function champion(w, path) {
    addHistory(c, `우승: ${w.name}`, w.emoji, '');
    const final = path.slice(-3).reverse();
    layout(c, `<div class="result"><div class="crown">${art('👑')}</div><div class="reveal-box">${visual(w.image, w.emoji, w.color, 'hero-thumb')}<span class="sparkle">✦</span><span class="sparkle">✦</span><span class="sparkle">✦</span><span class="sparkle">✦</span></div>
      <p class="label">${esc(c.title)} 최종 우승</p><h1>${esc(w.name)}</h1>
      <div class="path">${final.map(p => `<div><b>${esc(p.w)}</b><span>${p.r} · vs ${esc(p.l)}</span></div>`).join('')}</div>
      <a class="btn btn-main" href="#/play/${c.id}">${ic('rotate-ccw')} 다시 하기</a>${saveBtn(c.title, '우승 ' + w.name, w.emoji, w.color, ['최종 우승'])}${shareRow(c, `내 ${c.title} 우승은 ${w.name}! 너는?`)}</div>`);
    confetti(); sfx('win'); keyHandler = null;
  }
}

